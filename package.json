{
  "name": "@aberwest/bedrock",
  "version": "0.1.0",
  "description": "Aberwest React component library built on shadcn/ui, Radix UI and Tailwind CSS.",
  "license": "MIT",
  "author": "Aberwest",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "components",
    "ui",
    "shadcn",
    "tailwind",
    "radix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run gen:index && npm run license:fix && vite build && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "gen:index": "node scripts/gen-index.mjs",
    "add": "shadcn add",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "npm run license:check && vitest run",
    "playground": "vite --config vite.playground.config.ts --open",
    "license:check": "node scripts/license-headers.mjs",
    "license:fix": "node scripts/license-headers.mjs --fix",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.7",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.76.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  }
}
